# Copy to .env (git-ignored) and fill in. Never commit .env.
# Get these from https://open.alphaess.com (Developer ID = APP ID, Developer Key = APP secret).
ALPHA_APP_ID=
ALPHA_APP_SECRET=
# Optional: only needed if your developer account has more than one system.
ALPHA_SYSTEM_SN=

# Optional overrides (defaults shown)
# ENERGY_DB=energy.db
# ENERGY_CONFIG=config.toml
