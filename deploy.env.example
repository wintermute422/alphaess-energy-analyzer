# Copy to deploy.env (git-ignored) to use deploy.sh / rollback.sh.
# SSH destination of the Linux machine that runs the nightly job.
DEPLOY_HOST=your-server.example
DEPLOY_USER=your-user
# Path to the SSH private key on this machine (leave empty to use your ssh config/agent).
DEPLOY_SSH_KEY=
# Install path on the target (no sudo needed). ~ is expanded on the target.
DEPLOY_PATH=~/alphaess-energy-analyzer
# Number of releases to keep on the target.
DEPLOY_KEEP_RELEASES=3
# systemd OnCalendar expression for the nightly run.
DEPLOY_ONCALENDAR=*-*-* 03:30:00
# Web dashboard: address to listen on (0.0.0.0 = whole LAN, 127.0.0.1 = this machine only,
# empty = do not install the dashboard) and port. A login password is generated into
# shared/.env on the target if missing (read it with: grep WEB_PASSWORD shared/.env).
DEPLOY_WEB_HOST=0.0.0.0
DEPLOY_WEB_PORT=8088
# How often today's data is refreshed for the dashboard (empty = never, only the nightly run).
DEPLOY_REFRESH_ONCALENDAR=*:0/15
